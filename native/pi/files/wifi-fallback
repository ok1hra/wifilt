APPLIED = """<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>WIFILT - Wi-Fi</title></head>
<body style="font-family:system-ui,sans-serif;padding:16px">
<h1>Switching...</h1>
<p>The access point goes down and {host} tries the saved networks.
Join the same network and open <b>http://{host}.local/</b>.</p>
<p>If it does not connect, the access point "{ap}" comes back.</p></body></html>"""


def make_handler(conf):
    host = socket.gethostname()
    portal_hosts = {conf["PORTAL_ADDR"], conf["AP_ADDR"],
                    f"{conf['AP_ADDR']}:{conf['PORTAL_PORT']}"}

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, fmt, *args):
            pass

        def send(self, code, body="", headers=()):
            data = body.encode()
            self.send_response(code)
            for k, v in headers:
                self.send_header(k, v)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def redirect(self, query=""):
            self.send(302 if self.command == "GET" else 303, "",
                      [("Location", f"http://{conf['PORTAL_ADDR']}/{query}")])

        def page(self, msg=""):
            e = html.escape
            try:
                rows = "".join(
                    f"<tr><td>{e(n['ssid'])}{' <span class=muted>(hidden)</span>' if n['hidden'] else ''}</td>"
                    f"<td class=muted>{n['prio']}</td><td style='text-align:right'>"
                    f"<form method=post action=/delete style=margin:0>"
                    f"<input type=hidden name=uuid value='{e(n['uuid'])}'>"
                    f"<button class=del onclick=\"return confirm('Delete this network?')\">&#x2715;</button>"
                    f"</form></td></tr>" for n in known_networks())
            except Exception as ex:
                rows, msg = "", msg or str(ex)
            scan_rows = "".join(
                f"<tr class=scan data-ssid='{e(s)}'><td>{e(s)}</td>"
                f"<td class=muted>{sig} %</td><td class=muted>{e(sec or 'open')}</td></tr>"
                for s, sig, sec in SCAN)
            self.send(200, PAGE.format(
                host=e(host), ap=e(conf["AP_SSID"]), ap_addr=conf["AP_ADDR"],
                msg=f"<div class=msg>{e(msg)}</div>" if msg else "",
                known=rows or "<tr><td class=muted>none</td></tr>",
                scan=scan_rows or "<tr><td class=muted>nothing found</td></tr>"))

        def do_GET(self):
            # foreign names (the phone's captive portal check) -> portal
            if self.headers.get("Host", "") not in portal_hosts:
                return self.redirect()
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            self.page(q.get("err", [""])[0])

        def do_POST(self):
            length = min(int(self.headers.get("Content-Length") or 0), 4096)
            form = urllib.parse.parse_qs(self.rfile.read(length).decode(errors="replace"))
            get = lambda k: form.get(k, [""])[0]
            try:
                if self.path == "/add":
                    add_network(conf["IFACE"], get("ssid").strip(), get("psk"),
                                max(-999, min(999, int(get("prio") or 0))), bool(get("hidden")))
                elif self.path == "/delete":
                    delete_network(get("uuid"))
                elif self.path == "/apply":
                    self.send(200, APPLIED.format(host=html.escape(host),
                                                  ap=html.escape(conf["AP_SSID"])))
                    # let the page arrive before the access point disappears
                    threading.Timer(2, APPLY.set).start()
                    return
            except Exception as ex:
                return self.redirect("?err=" + urllib.parse.quote(str(ex)))
            self.redirect()

    return Handler


# ---------------------------------------------------------------------------

def main():
    conf = load_conf()
    iface = conf["IFACE"]
    signal.signal(signal.SIGTERM, lambda *_: STOP.set())
    signal.signal(signal.SIGINT, lambda *_: STOP.set())

    # leftovers from a crash
    nft_down()
    ensure_ap_profile(conf)
    log(f"{iface}: waiting up to {conf['BOOT_WAIT']} s for a known network")

    # after boot the access point comes after BOOT_WAIT, during operation after LOST_WAIT
    down_since = time.monotonic() - conf["LOST_WAIT"] + conf["BOOT_WAIT"]
    while not STOP.is_set():
        try:
            if wifi_connected(iface):
                if down_since is not None:
                    log(f"{iface}: connected ({device_state(iface)[1]})")
                down_since = None
            elif down_since is None:
                down_since = time.monotonic()
                log(f"{iface}: disconnected, access point in {conf['LOST_WAIT']} s unless it reconnects")
            elif time.monotonic() - down_since >= conf["LOST_WAIT"]:
                fallback_cycle(conf)
                down_since = None
        except Exception as e:
            log(f"ERROR: {e}")
        STOP.wait(5)
    log("stopped")


if __name__ == "__main__":
    main()
