+
+/* Percent (0-100) of random jitter applied to every fresh retry/wait
+ * deadline derived from a mode-timing table entry's ack_timeout_s or
+ * retry_interval_s (see arq_protocol_jitter_retry_s()). 0 = off (native
+ * unit/sim tests never touch this atomic, so they stay bit-for-bit
+ * deterministic). Found needed 2026-08-27, live two-station RF testing:
+ * these values come from a fixed per-mode table -- IDENTICAL on both
+ * stations for a given mode, no randomization at all. CALL/ACCEPT already
+ * had this exact class of bug (see arq_callint_override_s's own history)
+ * and was fixed with per-station jitter; every OTHER blind fixed-interval
+ * wait in the FSM (WAIT_ACK's own ack retry, TURN_REQ_WAIT, MODE_REQ_WAIT,
+ * KEEPALIVE_WAIT, IRS backlog/inactivity checks -- arq_fsm.c's whole family
+ * of `deadline_from_s(tm ? tm->retry_interval_s : ...)` calls) never got the
+ * same treatment. Confirmed live, twice, in two DIFFERENT exchanges: first
+ * a station's own piggybacked reply (a resume-query REPLY) colliding with
+ * the peer's real DATA_TX in WAIT_ACK; then, after jittering WAIT_ACK alone,
+ * the identical symptom recurred one layer over, in a simultaneous MODE_REQ/
+ * TURN_REQ negotiation -- proof this was never WAIT_ACK-specific, it is
+ * generic to every unjittered retry_interval_s wait. A station's own fixed,
+ * identical retry cadence can keep two sides colliding on every single
+ * attempt indefinitely -- neither side ever hears the other (a true
+ * double-blind mutual collision, not something a *reactive* resend can fix,
+ * since neither side gets any event to react to). Applied at every call
+ * site that re-derives one of these deadlines on each retry (not just once
+ * per session), so retries that start out colliding actively drift apart
+ * of staying locked in phase. */
+extern _Atomic int arq_data_retry_jitter_pct;
+#define ARQ_DATA_RETRY_JITTER_PCT  atomic_load(&arq_data_retry_jitter_pct)
+
 #define ARQ_TURN_WAIT_AFTER_ACK_MS   5000  /* IRS post-ACK wait before TURN_REQ:
                                             * ISS guard(900ms)+frame(3740ms)+margin */
 #define ARQ_ACCEPT_RX_WINDOW_MS      9000  /* ACCEPTING RX window after ACCEPT TX:
@@ -311,6 +340,38 @@ extern _Atomic int arq_ladder_up_successes;
 extern _Atomic int arq_retry_downgrade_threshold;
 #define ARQ_RETRY_DOWNGRADE_THRESHOLD  atomic_load(&arq_retry_downgrade_threshold)
 
