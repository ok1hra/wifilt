@@ -32,6 +34,10 @@ _Atomic int arq_mode_hold_after_downgrade_s = ARQ_MODE_HOLD_AFTER_DOWNGRADE_S_DE
 _Atomic int arq_peer_payload_hold_s         = ARQ_PEER_PAYLOAD_HOLD_S_DEFAULT;
 _Atomic int arq_startup_max_s               = ARQ_STARTUP_MAX_S_DEFAULT;
 
+/* Runtime-configurable ceiling on our own outbound mode selection (see
+ * ARQ_MODE_CEILING_RANK's own comment in arq_protocol.h) */
+_Atomic int arq_mode_ceiling_rank           = ARQ_MODE_CEILING_RANK_DEFAULT;
+
 /* Include FreeDV mode constants */
 #include "../modem/freedv/freedv_api.h"
 
@@ -128,6 +134,21 @@ float arq_protocol_call_interval_s(void)
     return tm ? tm->retry_interval_s : 8.0f;
 }
 
+float arq_protocol_jitter_retry_s(float base_s)
+{
+    int pct = atomic_load(&arq_data_retry_jitter_pct);
+    if (pct <= 0)
+        return base_s;
+    if (pct > 100)
+        pct = 100;
+    /* Uniform in [-pct%, +pct%]. rand() is fine here -- this path is
+     * unreachable with the default-0 atomic, so no native unit/sim test
+     * (none of which ever raise it) sees a non-deterministic draw. */
+    float frac = ((float)(rand() % 2001) - 1000.0f) / 1000.0f; /* [-1, 1] */
+    float jittered = base_s * (1.0f + frac * ((float)pct / 100.0f));
+    return jittered > 0.0f ? jittered : base_s;
+}
+
