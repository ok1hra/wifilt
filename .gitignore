/build/
/wifilt.ino*.bin

# Native build output. The leading slash on /build/ above only covers the
# Arduino one, so these need naming separately: object files, the two binaries
# and the release archives are all reproducible from source.
/native/build/
/native/build-win/
/native/dist/
/native/_run/

# PlatformIO firmware build output and its local cache (the fetched TrxNet
# library lives here too). All reproducible from source.
/.pio/
/data/*.gz
/data/*.br
/data/*.js.min
/data/.minified-js.sha256
/prototype/js8-core-prototype/build*/
/prototype/js8-core-prototype/**/*.md
/prototype/js8-core-prototype/*.md
/prototype/mercury-prototype/build*/
/prototype/mercury-prototype/**/*.md
/prototype/mercury-prototype/*.md
# Keep only the pinned JS8/Eigen subset required by build-js8-assets.sh.
/JS8Call-improved-master/*
!/JS8Call-improved-master/LICENSE
!/JS8Call-improved-master/JS8_Mode/
!/JS8Call-improved-master/JS8_Mode/**
!/JS8Call-improved-master/JS8_Include/
/JS8Call-improved-master/JS8_Include/*
!/JS8Call-improved-master/JS8_Include/commons.h
!/JS8Call-improved-master/JS8_JSC/
/JS8Call-improved-master/JS8_JSC/*
!/JS8Call-improved-master/JS8_JSC/JSC_map.cpp
!/JS8Call-improved-master/vendor/
/JS8Call-improved-master/vendor/*
!/JS8Call-improved-master/vendor/Eigen/
!/JS8Call-improved-master/vendor/Eigen/**
/tools/__pycache__/
*.pyc
/.claude/
/.vscode/
/log/
/wfview-master/
/ic705-history-backup.json

# Manufacturer and third-party manuals. These are copyrighted works we hold no
# redistribution licence for -- they are reference material for development
# only and must never be published with the project.
/docs/*.pdf

# Published documentation is an allowlist, not a denylist. Everything in docs/
# is a working note until it is named here, because the alternative -- listing
# the drafts -- silently publishes every new one. Only English documents that
# something in the repository actually links to belong below.
/docs/*.md
/docs/agents/
!/docs/find-device-ip.md
!/docs/js8call-build.md
!/docs/trxnet.md
!/docs/trx-http-api.md
!/docs/aud1-audio-websocket-protocol.md
!/docs/wspr.md

# Device filesystem dumps, release snapshots and the upstream Mercury checkout
# (its own git repository -- vendor it deliberately if it is ever needed).
/backups/
/mercury/
# Own git repository (remote ok1cdj/FT8web), not a registered submodule --
# vendor it deliberately if it is ever needed.
/FT8web/
*.zip
/convert_logs.py
/AGENTS.md
